# Copy this file to .env and fill in the values for your test tenant.
# .env is git-ignored. Never commit real values.

# Directory (tenant) ID and application (client) ID of the app registration
AIRLOCK_TENANT_ID=00000000-0000-0000-0000-000000000000
AIRLOCK_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Use ONE of the two credential options below.
# Certificate (preferred): thumbprint of a certificate in the current user store
AIRLOCK_CERT_THUMBPRINT=
# Client secret (fallback for lab tenants)
AIRLOCK_CLIENT_SECRET=

# Optional: where change logs are written (default is ./logs)
AIRLOCK_LOG_DIR=
